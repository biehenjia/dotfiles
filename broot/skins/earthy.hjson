# earthy — transparent broot skin, matched to the rest of this setup:
# ghostty (Everforest Dark Hard @ 0.45 opacity) showing through, sage / moss /
# terracotta accents from the starship palette, same as earthy-transparent.micro.
#
# Every entry leaves the background as `none` (terminal shows through) except the
# handful of elements that genuinely need a fill to stay legible: the status bar,
# the selected row, the input field, verb popups, and match highlights.
#
# broot parses each value as an unquoted hjson string running to end of line, so
# colors must be rgb(r,g,b) / ansi(n) / gray(n) / a name — a leading `#` starts a
# comment here, so hex literals do NOT work. Palette, for reference:
#   cream   rgb(251,247,240)   sand    rgb(241,233,220)   mushroom rgb(231,225,213)
#   p.sage  rgb(207,225,214)   sage    rgb(169,198,178)   moss     rgb(110,156,122)
#   pine    rgb(63,107,79)     bark    rgb(58,63,53)       bark-lo  rgb(47,52,43)
#   grey-g  rgb(127,140,120)   grey    rgb(92,99,87)
#   terra   rgb(181,121,63)    amber   rgb(201,143,90)     red      rgb(217,83,79)
#
# `fg bg [attrs] / inactive-fg inactive-bg [attrs]` — second half styles the
# non-focused panel.

skin: {
    default: rgb(241,233,220) none / rgb(169,177,160) none

    tree: rgb(92,99,87) none / rgb(74,80,70) none
    parent: rgb(169,198,178) none / rgb(127,140,120) none
    file: rgb(231,225,213) none / rgb(169,177,160) none
    directory: rgb(169,198,178) none bold / rgb(133,158,142) none bold
    exe: rgb(201,143,90) none
    link: rgb(110,156,122) none
    pruning: rgb(127,140,120) none italic

    perm__: rgb(92,99,87) none
    perm_r: rgb(169,198,178) none
    perm_w: rgb(201,143,90) none
    perm_x: rgb(110,156,122) none
    owner: rgb(127,140,120) none
    group: rgb(92,99,87) none
    count: rgb(207,225,214) none
    dates: rgb(127,140,120) none
    sparse: rgb(201,143,90) none

    content_extract: rgb(110,156,122) none
    content_match: rgb(169,198,178) none bold

    git_branch: rgb(201,143,90) none
    git_insertions: rgb(110,156,122) none
    git_deletions: rgb(217,83,79) none
    git_status_current: rgb(241,233,220) none
    git_status_modified: rgb(201,143,90) none
    git_status_new: rgb(110,156,122) none bold
    git_status_ignored: rgb(92,99,87) none
    git_status_conflicted: rgb(217,83,79) none bold
    git_status_other: rgb(217,83,79) none

    selected_line: none rgb(47,52,43) / none rgb(42,46,38)
    char_match: rgb(201,143,90) none bold
    file_error: rgb(217,83,79) none

    flag_label: rgb(127,140,120) none
    flag_value: rgb(201,143,90) none bold
    input: rgb(241,233,220) none / rgb(127,140,120) none

    # Status bar — dark bark text on sage, the same identity as
    # earthy-transparent.micro's status line.
    status_error: rgb(251,247,240) rgb(158,75,69)
    status_job: rgb(201,143,90) rgb(47,52,43)
    status_normal: rgb(47,52,43) rgb(169,198,178) / rgb(92,99,87) rgb(47,52,43)
    status_italic: rgb(63,107,79) rgb(169,198,178) italic / rgb(92,99,87) rgb(47,52,43)
    status_bold: rgb(47,52,43) rgb(169,198,178) bold / rgb(92,99,87) rgb(47,52,43)
    status_code: rgb(58,63,53) rgb(169,198,178) / rgb(92,99,87) rgb(47,52,43)
    status_ellipsis: rgb(63,107,79) rgb(169,198,178) / rgb(92,99,87) rgb(47,52,43)

    purpose_normal: rgb(241,233,220) rgb(47,52,43)
    purpose_italic: rgb(169,198,178) rgb(47,52,43) italic
    purpose_bold: rgb(201,143,90) rgb(47,52,43) bold
    purpose_ellipsis: rgb(127,140,120) rgb(47,52,43)

    scrollbar_track: rgb(58,63,53) none / rgb(47,52,43) none
    scrollbar_thumb: rgb(169,198,178) none / rgb(110,156,122) none

    help_paragraph: rgb(231,225,213) none
    help_bold: rgb(201,143,90) none bold
    help_italic: rgb(169,198,178) none italic
    help_code: rgb(207,225,214) rgb(47,52,43)
    help_headers: rgb(201,143,90) none bold
    help_table_border: rgb(92,99,87) none

    preview: rgb(231,225,213) none / rgb(169,177,160) none
    preview_title: rgb(47,52,43) rgb(169,198,178) / rgb(92,99,87) rgb(47,52,43)
    preview_line_number: rgb(92,99,87) rgb(47,52,43)
    preview_separator: rgb(58,63,53) none
    preview_match: none rgb(63,107,79)

    hex_null: rgb(92,99,87) none
    hex_ascii_graphic: rgb(231,225,213) none
    hex_ascii_whitespace: rgb(127,140,120) none
    hex_ascii_other: rgb(201,143,90) none
    hex_non_ascii: rgb(181,121,63) none

    staging_area_title: rgb(47,52,43) rgb(169,198,178) / rgb(92,99,87) rgb(47,52,43)
    mode_command_mark: rgb(251,247,240) rgb(63,107,79) bold

    # good → bad gradient: pine through sage, muddying to amber, ending at red.
    good_to_bad_0: rgb(63,107,79)
    good_to_bad_1: rgb(110,156,122)
    good_to_bad_2: rgb(169,198,178)
    good_to_bad_3: rgb(201,204,154)
    good_to_bad_4: rgb(217,185,138)
    good_to_bad_5: rgb(201,143,90)
    good_to_bad_6: rgb(193,127,69)
    good_to_bad_7: rgb(181,121,63)
    good_to_bad_8: rgb(168,92,58)
    good_to_bad_9: rgb(217,83,79)
}

# Preview pane syntax highlighting — no earthy/Everforest built-in; MochaDark is
# the closest muted dark.
syntax_theme: MochaDark
